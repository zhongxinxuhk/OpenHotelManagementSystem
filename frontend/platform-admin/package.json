{
  "name": "pms-platform-admin",
  "version": "0.1.0",
  "private": true,
  "description": "PMS 平台管理员控制台（Ant Design Pro + Umi Max，R-20261102-02）",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "max build",
    "dev": "cross-env UMI_ENV=dev MOCK=none max dev --port 8001",
    "lint": "npm run biome:lint && npm run tsc",
    "lint-staged": "lint-staged",
    "biome:lint": "biome lint",
    "biome": "biome check --write",
    "preview": "max preview --port 8001",
    "preview:build": "max build && max preview --port 8001",
    "start": "cross-env UMI_ENV=dev max dev --port 8001",
    "start:no-mock": "cross-env MOCK=none max dev --port 8001",
    "start:pre": "cross-env UMI_ENV=pre MOCK=none max dev --port 8001",
    "start:test": "cross-env UMI_ENV=test MOCK=none max dev --port 8001",
    "test": "vitest run",
    "test:watch": "vitest",
    "tsc": "max setup && tsc --noEmit"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/plots": "^2.6.8",
    "@ant-design/pro-components": "^3.1.14-2",
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "@ant-design/x-sdk": "^2.9.0",
    "@tanstack/react-query": "^5.104.5",
    "antd": "^6.6.7",
    "antd-style": "^4.1.0",
    "china-division": "^2.7.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dayjs": "^1.11.23",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.6.7",
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-helmet": "^6.1.11",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@umijs/lint": "^4.7.27",
    "@umijs/max": "^4.7.27",
    "@umijs/max-plugin-openapi": "^2.0.3",
    "@umijs/request-record": "^1.1.4",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "cross-env": "^10.1.0",
    "express": "^5.3.0",
    "geojson": "^0.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mockjs": "^1.1.0",
    "playwright": "^1.64.1",
    "react-doctor": "^0.9.18",
    "swagger-ui-dist": "^5.34.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components",
      "axios": "^1.19.0"
    },
    "@umijs/lint": {
      "@babel/core": "^7.29.6"
    },
    "dva-immer": {
      "immer": "^9.0.6"
    },
    "cosmiconfig": {
      "js-yaml": "^4.3.1"
    },
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
