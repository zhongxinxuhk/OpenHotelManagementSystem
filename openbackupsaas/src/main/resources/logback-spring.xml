<?xml version="1.0" encoding="UTF-8"?>
<!--
  结构化日志基线：单行、带时间戳/级别/请求关联 ID。
  原则（S2-06）：日志不得包含明文个人敏感信息、凭证或完整请求体。
-->
<configuration>
  <property name="LOG_PATTERN"
            value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC} %-5level [%X{requestId:-no-req}] %logger{36} - %msg%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
