# =====================================================================
# PMS 统一环境模板（S2-07）——中间件与后端（api/worker）共读这一份
#
# 用法：cp .env.example .env，至少设置四个密码（见"必填"标注）。
# .env 已被 .gitignore 忽略，不允许提交真实密码（S6-05）。
#
# 读取关系：
#   · docker compose 全部服务（postgres / rabbitmq / api / worker）都从本文件取值；
#   · 口令类变量只在这里出现一次，中间件创建账号、后端连接账号用的是同一个值——
#     不存在"两边各配一份然后悄悄不一致"的可能；
#   · 容器网络内的地址（postgres:5432 / rabbitmq:5672）不属于本文件：
#     它们由 compose 的服务拓扑决定，写在 deploy/compose/docker-compose.yml 里。
#
# 后端配置全集见 openbackupsaas/src/main/resources/application*.properties
# （每个配置项都是 ${PMS_*:默认值} 形式，可直接用环境变量覆盖）；
# 本文件只列"部署时最常改"的项，未列出的加进 .env 即生效。
# =====================================================================

# ---------- PostgreSQL 中间件 ----------
# 超级用户口令（初始化与运维用）。必填。
POSTGRES_PASSWORD=change-me-super

# 业务账号口令：中间件用它建角色（initdb），后端用它连接——同一个值，一处管理。
#   PMS_DB_PASSWORD          → spring.datasource.password（应用账号 pms_app，仅 DML）
#   PMS_DB_MIGRATOR_PASSWORD → spring.flyway.password（迁移账号 pms_migrator，仅 DDL）
# 必填。
PMS_DB_PASSWORD=change-me-app
PMS_DB_MIGRATOR_PASSWORD=change-me-migrator

# 库名与宿主端口。库名默认 pms；宿主端口默认 55432（与应用 PMS_DB_PORT 默认值一致）。
# 注意：与 scripts/dev-db.sh 的本地集群端口相同，二者同时只能起一个；
# 需要并存时在这里改端口（例如 55433）。
PMS_DB_NAME=pms
#PMS_DB_PORT=55432
# 连接池大小（后端 api / worker 各自生效）
#PMS_DB_POOL_SIZE=10

# ---------- RabbitMQ 中间件 ----------
# 与后端连接配置对应（PMS_RABBIT_USER / PMS_RABBIT_PASSWORD）——同一个值，一处管理。
# 注意：默认用户只在数据卷**首次初始化**时创建；改用户/密码后需要
# `docker compose down -v` 重建，或在管理界面手工同步。
# 必填。
PMS_RABBIT_USER=pms_mq
PMS_RABBIT_PASSWORD=change-me-mq

# AMQP 端口（宿主）默认 55672；管理界面默认 15672。
#PMS_RABBIT_PORT=55672
#PMS_RABBIT_MANAGEMENT_PORT=15672

# ---------- 后端（api / worker，裸机运行 deploy/app.sh） ----------
# 后端配置全集是 ${PMS_*:默认值} 形式（application*.properties），这里只列最常用的。
# 裸机脚本 deploy/app.sh 会 source 本文件并把变量导出给 java 进程——
# 与中间件读同一个文件（口令单源：中间件建账号、后端连接账号，同一个值）。
#
# Spring 档案固定 local（它只是"配置取自环境变量"的档案，不依赖 trust 认证）。
# OpenAPI/Swagger：本地开发默认开；共享/预发环境显式置 false。
#PMS_OPENAPI_ENABLED=false
#
# JVM 参数（api 与 worker 共用）
#JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
#
# 后端 HTTP 端口（api 用；默认 8080）
#PMS_SERVER_PORT=8080
#
# 运行角色由脚本固定（start api → PMS_RUNTIME_ROLE=api；start worker → worker），
# 不要在本文件覆盖 PMS_RUNTIME_ROLE——拆分本身就是部署拓扑的一部分。

# ---------- 其它 ----------
# 容器日志时区（不影响数据库 timestamptz 存储，永远 UTC）
TZ=Australia/Brisbane
