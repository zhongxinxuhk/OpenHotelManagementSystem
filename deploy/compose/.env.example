# =====================================================================
# PMS 中间件环境模板（S2-07）
#
# 用法：cp .env.example .env，然后至少设置三个密码。
# .env 已被 .gitignore 忽略，不允许提交真实密码（S6-05）。
# =====================================================================

# ---------- PostgreSQL ----------
# 超级用户口令（容器内初始化与运维操作用）。必填。
POSTGRES_PASSWORD=change-me-super

# 业务账号口令（应用账号 pms_app 只 DML / 迁移账号 pms_migrator 只 DDL）。
# 与应用侧连接配置一一对应：
#   PMS_DB_PASSWORD        → spring.datasource.password
#   PMS_DB_MIGRATOR_PASSWORD → spring.flyway.password
PMS_DB_PASSWORD=change-me-app
PMS_DB_MIGRATOR_PASSWORD=change-me-migrator

# 库名与连接端口。库名默认 pms；宿主端口默认 55432（与应用 PMS_DB_PORT 默认值一致）。
# 注意：与 scripts/dev-db.sh 的本地集群端口相同，二者同时只能起一个；
# 需要并存时在这里改端口（例如 55433）。
PMS_DB_NAME=pms
#PMS_DB_PORT=55432

# ---------- RabbitMQ ----------
# 与应用侧连接配置对应：PMS_RABBIT_USER / PMS_RABBIT_PASSWORD。
# 注意：默认用户只在数据卷**首次初始化**时创建；改用户/密码后需要
# `docker compose down -v` 重建，或在管理界面手工同步。
PMS_RABBIT_USER=pms_mq
PMS_RABBIT_PASSWORD=change-me-mq

# AMQP 端口（宿主）默认 55672；管理界面默认 15672（浏览器打开 http://localhost:15672）。
#PMS_RABBIT_PORT=55672
#PMS_RABBIT_MANAGEMENT_PORT=15672

# ---------- 其它 ----------
# 容器日志时区（不影响数据库 timestamptz 存储，永远 UTC）
TZ=Australia/Brisbane
