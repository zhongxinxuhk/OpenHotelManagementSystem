            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "items": {
                "enum": [
                  "PENDING",
                  "CONFIRMED",
                  "CHECKED_IN",
                  "CHECKED_OUT",
                  "CANCELLED",
                  "EXPIRED",
                  "NO_SHOW"
                ],
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "sourceType",
            "required": false,
            "schema": {
              "enum": [
                "FRONTDESK",
                "DIRECT",
                "OTA",
                "MINIPROGRAM"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "no",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "roomCode",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "stayFrom",
            "required": false,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "stayTo",
            "required": false,
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageViewReservationSummary"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "reservation-query-controller"
        ]
      },
      "post": {
        "operationId": "create_2",
