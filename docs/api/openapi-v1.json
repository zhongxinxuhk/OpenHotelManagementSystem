            }
          },
          {
            "in": "header",
            "name": "X-Caller-Namespace",
            "required": false,
            "schema": {
              "default": "frontend",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReservationRequest"
